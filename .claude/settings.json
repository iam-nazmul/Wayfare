{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(git stash list*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose config*)",
      "Bash(docker compose build*)",
      "Bash(docker compose run --rm api python manage.py check*)",
      "Bash(docker compose run --rm api python manage.py showmigrations*)",
      "Bash(docker compose run --rm api python manage.py makemigrations --check*)",
      "Bash(docker compose run --rm api python manage.py spectacular*)",
      "Bash(docker compose run --rm api pytest*)",
      "Bash(docker compose run --rm api ruff*)",
      "Bash(docker compose run --rm api mypy*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(npx eslint*)",
      "Bash(npx playwright test*)",
      "Bash(npx openapi-typescript*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s http://127.0.0.1*)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(find . *)",
      "Bash(tree *)"
    ],
    "ask": [
      "Bash(make clean)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Edit(./.env)",
      "Edit(./backend/.env)",
      "Edit(./frontend/.env)"
    ]
  }
}
